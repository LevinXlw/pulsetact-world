{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pulsetact-world",
  "account_id": "f8ba591d587f8a4d538c4a73bc3928fe",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "world.pulsetact.ai", "custom_domain": true }],
  "assets": {
    "directory": "./dist-cloud",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [{ "name": "AUTH_STORE", "class_name": "AuthStore" }]
  },
  "migrations": [{ "tag": "v1-auth", "new_sqlite_classes": ["AuthStore"] }],
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "observability": { "enabled": true }
}
